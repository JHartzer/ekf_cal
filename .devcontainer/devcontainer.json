{
    "name": "ROS2-env",
    "customizations": {
        "vscode": {
            "extensions": [
                "fabiospampinato.vscode-todo-plus",
                "llvm-vs-code-extensions.vscode-clangd",
                "mhutchie.git-graph",
                "ms-python.autopep8",
                "ms-python.debugpy",
                "ms-python.flake8",
                "ms-python.python",
                "ms-python.vscode-python-envs",
                "ms-vscode.cmake-tools",
                "streetsidesoftware.code-spell-checker",
                "twxs.cmake",
                "zachflower.uncrustify"
            ]
        }
    },
    "build": {
        "dockerfile": "../Dockerfile",
        "args": {
            "USERNAME": "vscode",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "workspaceMount": "src=${localWorkspaceFolder},dst=/ekf_cal_ws/src/ekf_cal,type=bind,consistency=cached",
    "workspaceFolder": "/ekf_cal_ws/src/ekf_cal",
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "updateRemoteUserUID": true,
    "postCreateCommand": "pre-commit install",
    "postStartCommand": "sudo mkdir -p /ekf_cal_ws/build /ekf_cal_ws/install /ekf_cal_ws/log && sudo chown $(id -u):$(id -g) /ekf_cal_ws /ekf_cal_ws/src /ekf_cal_ws/build /ekf_cal_ws/install /ekf_cal_ws/log",
    // Args necessary for perf permissions
    "runArgs": [
        "--cap-add=SYS_ADMIN",
        "--security-opt",
        "seccomp=unconfined"
    ]
}
